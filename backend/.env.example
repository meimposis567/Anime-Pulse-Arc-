# ---- Server ----
PORT=5001
NODE_ENV=development

# ---- Upstream anime data source (AniList GraphQL) ----
ANILIST_URL=https://graphql.anilist.co

# ---- Database ----
# Local:  mongodb://localhost:27017/anime_pulse_arc
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/anime_pulse_arc?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/anime_pulse_arc

# ---- Auth ----
# Use a long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# ---- CORS (optional) ----
# Extra origin allowed to call this API in production
FRONTEND_URL=
