# ---- Server ----
PORT=5001
NODE_ENV=development

# ---- Upstream anime data source (AniList GraphQL) ----
ANILIST_URL=https://graphql.anilist.co

# ---- Database (required) ----
# Local:  mongodb://localhost:27017/anime_pulse_arc
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/anime_pulse_arc
MONGODB_DB=anime_pulse_arc

# ---- Auth (required) ----
# Must be at least 32 characters. The server REFUSES TO START if this is
# missing, too short, or left as a placeholder — there is no insecure default.
#
#   openssl rand -hex 32
#
# PowerShell:
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
JWT_SECRET=

# How long an access token stays valid (zeit/ms format: 15m, 12h, 7d).
JWT_EXPIRES_IN=7d

# bcrypt cost factor. Higher is slower and stronger; 12 is a good default.
BCRYPT_ROUNDS=12

# ---- CORS (optional) ----
# Extra origin allowed to call this API in production, e.g. https://your-app.com
FRONTEND_URL=
